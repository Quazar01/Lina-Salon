---
// Fraunces "soft" subset: weight + SOFT axes only (half the size of the full font).
import '@fontsource-variable/fraunces/soft.css';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';
import '@fontsource-variable/fraunces/wght-italic.css'; // accent words only
import '@fontsource-variable/outfit';
import '@fontsource-variable/el-messiri'; // Arabic headings
import elMessiriArabic from '@fontsource-variable/el-messiri/files/el-messiri-arabic-wght-normal.woff2?url';
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '../styles/global.css';

import { LOCALES, LOCALE_META, type Locale } from '../lib/i18n';
import { hours, settings } from '../lib/site';
import { DAYS } from '../lib/hours';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  image?: string;
}

const { locale, title, description, image } = Astro.props;
const meta = LOCALE_META[locale];
const site = Astro.site ?? new URL('https://linasalon.be');
const canonical = new URL(`/${locale}/`, site).href;
const ogImage = image ? new URL(image, site).href : undefined;

const schemaDay: Record<string, string> = {
  mon: 'Monday', tue: 'Tuesday', wed: 'Wednesday', thu: 'Thursday',
  fri: 'Friday', sat: 'Saturday', sun: 'Sunday',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: 'Lina Salon',
  url: canonical,
  telephone: settings.phone,
  priceRange: '€€',
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.street,
    postalCode: settings.postcode,
    addressLocality: settings.city,
    addressCountry: 'BE',
  },
  openingHoursSpecification: hours
    .filter((h) => !h.closed && h.open && h.close)
    .sort((a, b) => DAYS.indexOf(a.day) - DAYS.indexOf(b.day))
    .map((h) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: schemaDay[h.day],
      opens: h.open,
      closes: h.close,
    })),
  sameAs: [settings.instagram, settings.facebook, settings.tiktok].filter(Boolean),
};
---

<!doctype html>
<html lang={meta.bcp47} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {/* Preload the heading font of this page's script so the hero doesn't shift when it swaps in. */}
    <link rel="preload" href={meta.dir === 'rtl' ? elMessiriArabic : frauncesLatin} as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].bcp47} href={new URL(`/${l}/`, site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site).href} />
    <meta name="theme-color" content="#fdf8f5" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lina Salon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.bcp47.replace('-', '_')} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-svh overflow-x-clip">
    <slot />

    <script>
      // Scroll reveal: elements fade/slide in once as they enter the viewport.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
