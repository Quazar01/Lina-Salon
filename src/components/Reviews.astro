---
import { Icon } from 'astro-icon/components';
import Stars from './Stars.astro';
import reviewsData from '../content/reviews.json';
import { LOCALE_META, isLocale, ui, type Locale } from '../lib/i18n';
import { settings, showReviews } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);

type Review = { author: string; rating: number; language: string; quote: string };
const reviews = (reviewsData.reviews as Review[]).filter((r) => r.quote?.trim());
// Hidden until the owner switches them on in the CMS (settings → showReviews).
const [featured, ...rest] = showReviews ? reviews : [];

// Quotes stay in the language they were written in; mark them up so Arabic renders RTL inside a Dutch page.
const langAttrs = (r: Review) =>
  isLocale(r.language) ? { lang: LOCALE_META[r.language].bcp47, dir: LOCALE_META[r.language].dir } : { dir: 'auto' };
const initials = (name: string) =>
  name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

{
  featured && (
    <section id="reviews" class="panel bg-blush py-20 md:py-28" aria-labelledby="reviews-title">
      <div class="container-page">
        <header class="flex flex-wrap items-end justify-between gap-6" data-reveal>
          <div>
            <p class="eyebrow">{t.reviews.eyebrow}</p>
            <h2 id="reviews-title" class="display mt-3 text-[2.1rem] md:text-5xl">{t.reviews.title}</h2>
          </div>
          {settings.googleReviewsUrl && (
            <a href={settings.googleReviewsUrl} class="btn btn-quiet" target="_blank" rel="noopener">
              {t.reviews.seeAll}
              <Icon name="ph:arrow-up-right" class="flip-rtl size-4" aria-hidden="true" />
            </a>
          )}
        </header>

        <div class="mt-10 grid gap-10 md:grid-cols-12 md:gap-8">
          <figure class="relative md:col-span-7" data-reveal>
            <span
              class="pointer-events-none absolute -top-10 -start-2 font-display text-[8rem] leading-none text-accent/15 italic select-none md:-top-14 md:-start-6 md:text-[11rem]"
              aria-hidden="true"
              lang="en"
            >
              “
            </span>
            <Stars n={featured.rating} label={t.reviews.rating} />
            <blockquote class="display relative mt-5 text-[1.6rem] leading-snug text-ink md:text-[2.1rem]" {...langAttrs(featured)}>
              <p>{featured.quote}</p>
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex size-11 items-center justify-center rounded-full bg-accent-soft text-sm font-semibold text-accent-deep" aria-hidden="true">
                {initials(featured.author)}
              </span>
              <span class="font-medium" dir="auto">{featured.author}</span>
            </figcaption>
          </figure>

          <ul class="divide-y divide-rosewood/60 border-t border-rosewood/60 md:col-span-5 md:border-t-0">
            {rest.map((r, i) => (
              <li class="py-6 first:md:pt-0" data-reveal style={`--i:${i + 1}`}>
                <figure>
                  <Stars n={r.rating} label={t.reviews.rating} />
                  <blockquote class="mt-3 text-ink" {...langAttrs(r)}>
                    <p>{r.quote}</p>
                  </blockquote>
                  <figcaption class="mt-3 text-sm font-medium text-ink-soft" dir="auto">
                    {r.author}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}
