---
import { Icon } from 'astro-icon/components';
import LangSwitcher from './LangSwitcher.astro';
import MobileMenu from './MobileMenu.astro';
import Wordmark from './Wordmark.astro';
import { THEME } from '../lib/theme';
import { ui, type Locale } from '../lib/i18n';
import { instagramHandle, showReviews, telHref, tiktokHandle } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);

const links = [
  ['about', t.nav.about],
  ['services', t.nav.services],
  ...(instagramHandle || tiktokHandle ? [['social', t.nav.social] as const] : []),
  ...(showReviews ? [['reviews', t.nav.reviews] as const] : []),
  ['visit', t.nav.visit],
] as const;
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-cream"
>
  {t.nav.skip}
</a>

<header class="sticky top-0 z-40 border-b border-petal/70 bg-cream/85 pt-[env(safe-area-inset-top)] backdrop-blur-md">
  <div class="container-page flex h-(--header-h) items-center gap-3">
    <a href={`/${locale}/`} class="me-auto text-ink">
      <Wordmark size={THEME === 'glam' ? 'text-[2.25rem]' : 'text-[1.6rem]'} />
    </a>

    <nav class="hidden lg:block" aria-label={t.nav.menu}>
      <ul class="flex items-center gap-1">
        {
          links.map(([id, label]) => (
            <li>
              <a
                href={`#${id}`}
                class="rounded-full px-3 py-2 text-[0.95rem] text-ink-soft transition-colors duration-200 hover:text-ink"
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <LangSwitcher locale={locale} />

    <a href={telHref} class="btn btn-primary hidden min-h-11 md:inline-flex">
      <Icon name="ph:phone" class="size-5" aria-hidden="true" />
      {t.cta.call}
    </a>

    <button
      type="button"
      class="btn -me-2 size-11 min-h-11 px-0 text-ink lg:hidden"
      data-menu-open
      aria-haspopup="dialog"
      aria-controls="mobile-menu"
      aria-label={t.nav.menu}
    >
      <Icon name="ph:list" class="size-6" aria-hidden="true" />
    </button>
  </div>
</header>

<MobileMenu locale={locale} links={links} />
