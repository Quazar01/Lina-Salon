---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import OpenBadge from './OpenBadge.astro';
import Sparkle from './Sparkle.astro';
import home from '../content/home.json';
import { emphasize, localize, t as tr, ui, type Locale } from '../lib/i18n';
import { resolveImage } from '../lib/images';
import { telHref, whatsappHref } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const title = localize(home.heroTitle, locale);
const text = localize(home.heroText, locale);
const womenOnly = localize(home.womenOnly, locale);
const image = resolveImage(home.heroImage);
---

<section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="bloom absolute inset-0 -z-10 [mask-image:linear-gradient(to_bottom,black_65%,transparent)]" aria-hidden="true"></div>
  <div
    class="container-page grid items-center gap-12 pt-8 pb-20 md:min-h-[calc(100svh-var(--header-h))] md:grid-cols-12 md:gap-8 md:py-12"
  >
    <div class="md:col-span-6">
      <div class="rise flex flex-wrap items-center gap-x-4 gap-y-3" style="--i:0">
        <span class="eyebrow">{t.hero.eyebrow}</span>
        <OpenBadge locale={locale} />
      </div>

      <h1
        id="hero-title"
        class="display rise mt-6 text-[2.75rem] text-ink sm:text-[3.4rem] lg:text-[4.5rem]"
        style="--i:1"
        lang={title.lang}
        dir={title.dir}
        set:html={emphasize(title.text)}
      />

      <p class="rise mt-5 max-w-[34ch] text-lg text-ink-soft md:text-xl" style="--i:2" lang={text.lang} dir={text.dir}>
        {text.text}
      </p>

      <div class="rise mt-8 flex flex-wrap gap-3" style="--i:3">
        <a href={whatsappHref(t.whatsappMessage)} class="btn btn-primary min-h-13 px-6">
          <Icon name="ph:whatsapp-logo" class="size-5" aria-hidden="true" />
          {t.cta.whatsapp}
        </a>
        <a href={telHref} class="btn btn-quiet min-h-13 px-6">
          <Icon name="ph:phone" class="size-5" aria-hidden="true" />
          {t.cta.call}
        </a>
      </div>
    </div>

    <!-- Arch-framed photo, like a salon mirror, with a thin offset outline echoing it. -->
    <div class="relative mx-auto w-[84%] max-w-[26rem] md:col-span-6 md:w-full lg:col-span-5 lg:col-start-8">
      <div class="arch absolute inset-0 translate-x-3 -translate-y-3 border border-rosewood rtl:-translate-x-3 md:translate-x-5 md:-translate-y-5 md:rtl:-translate-x-5" aria-hidden="true"></div>
      <Sparkle class="absolute -top-3 -start-5 size-7 text-accent/70 md:-start-10 md:size-9" />
      <Sparkle class="absolute top-1/3 -end-6 size-4 text-rosewood md:-end-12 md:size-5" />

      <div class="arch relative overflow-hidden bg-petal shadow-[0_40px_70px_-35px_rgb(143_63_82/0.55)]">
        {
          image && (
            <Image
              src={image}
              alt={tr(home.heroImageAlt, locale)}
              widths={[420, 640, 860, 1100]}
              sizes="(min-width: 1024px) 26rem, (min-width: 768px) 45vw, 84vw"
              loading="eager"
              fetchpriority="high"
              class="aspect-[4/5] w-full object-cover"
            />
          )
        }
      </div>

      <p
        class="glass absolute -start-4 -bottom-6 max-w-[calc(100%+1rem)] rounded-2xl px-4 py-3 text-[0.95rem] leading-snug font-medium text-ink md:-start-12 md:bottom-10 md:max-w-[16rem]"
        lang={womenOnly.lang}
        dir={womenOnly.dir}
      >
        <Icon name="ph:flower-lotus" class="me-1.5 inline size-5 align-[-0.22em] text-accent" aria-hidden="true" />
        {womenOnly.text}
      </p>
    </div>
  </div>
</section>
