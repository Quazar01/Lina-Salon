---
import services from '../content/services.json';
import { formatPrice, localize, ui, type Locale, type Localized } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);

type Item = { name: Localized; description?: Localized; price: number; from?: boolean; duration?: number };
type Category = { name: Localized; items: Item[] };
const categories = services.categories as Category[];
---

<section id="services" class="py-20 md:py-28" aria-labelledby="services-title">
  <div class="container-page grid gap-10 md:grid-cols-12 md:gap-8">
    <header class="min-w-0 md:col-span-4">
      <div class="md:sticky md:top-[calc(var(--header-h)+2.5rem)]" data-reveal>
        <p class="eyebrow">{t.services.eyebrow}</p>
        <h2 id="services-title" class="display mt-3 text-[2.1rem] md:text-5xl">{t.services.title}</h2>
        <p class="mt-4 max-w-[42ch] text-ink-soft">{t.services.intro}</p>

        <!-- Category jump links: a swipeable chip row on phones, a plain list on desktop. -->
        <nav class="no-scrollbar -mx-4 mt-6 overflow-x-auto px-4 md:mx-0 md:px-0" aria-label={t.services.eyebrow}>
          <ul class="flex w-max gap-2 md:w-auto md:flex-col md:gap-1">
            {
              categories.map((c, i) => {
                const name = localize(c.name, locale);
                return (
                  <li>
                    <a
                      href={`#cat-${i}`}
                      lang={name.lang}
                      dir={name.dir}
                      class="btn min-h-10 rounded-full border border-petal bg-surface px-4 text-[0.95rem] text-ink-soft md:min-h-0 md:justify-start md:border-0 md:bg-transparent md:px-0 md:py-1 md:hover:text-accent"
                    >
                      {name.text}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <div class="min-w-0 space-y-12 md:col-span-8 md:col-start-5 lg:col-span-7 lg:col-start-6">
      {
        categories.map((category, ci) => {
          const catName = localize(category.name, locale);
          return (
            <section id={`cat-${ci}`} aria-labelledby={`cat-${ci}-title`} data-reveal>
              <h3
                id={`cat-${ci}-title`}
                class="display border-b border-rosewood pb-3 text-2xl text-ink md:text-[1.75rem]"
                lang={catName.lang}
                dir={catName.dir}
              >
                {catName.text}
              </h3>
              <ul class="divide-y divide-petal">
                {category.items.map((item) => {
                  const name = localize(item.name, locale);
                  const desc = localize(item.description, locale);
                  return (
                    <li class="flex items-start justify-between gap-6 py-4">
                      <div class="min-w-0">
                        <p class="text-[1.05rem] font-medium text-ink" lang={name.lang} dir={name.dir}>
                          {name.text}
                        </p>
                        {desc.text && (
                          <p class="mt-1 text-[0.95rem] text-ink-soft" lang={desc.lang} dir={desc.dir}>
                            {desc.text}
                          </p>
                        )}
                        {item.duration ? (
                          <p class="mt-1 text-sm text-ink-faint">{t.services.minutes.replace('{n}', String(item.duration))}</p>
                        ) : null}
                      </div>
                      <p class="shrink-0 text-end leading-tight">
                        {item.from && <span class="block text-xs text-ink-faint">{t.services.from}</span>}
                        <span class="text-[1.05rem] font-semibold tabular-nums text-accent-deep" dir="ltr">
                          {formatPrice(item.price, locale)}
                        </span>
                      </p>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })
      }
    </div>
  </div>
</section>
