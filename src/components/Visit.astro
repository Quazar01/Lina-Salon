---
import { Icon } from 'astro-icon/components';
import OpenBadge from './OpenBadge.astro';
import { ui, type Locale } from '../lib/i18n';
import { DAYS } from '../lib/hours';
import { hours, mapEmbedSrc, routeHref, settings, telHref } from '../lib/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const byDay = new Map(hours.map((h) => [h.day, h]));
---

<section id="visit" class="py-20 md:py-28" aria-labelledby="visit-title">
  <div class="container-page grid gap-10 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5" data-reveal>
      <p class="eyebrow">{t.visit.eyebrow}</p>
      <h2 id="visit-title" class="display mt-3 text-[2.1rem] md:text-5xl">{t.visit.title}</h2>

      <div class="mt-8 grid gap-8 sm:grid-cols-2 md:grid-cols-1">
        <div>
          <h3 class="text-sm font-semibold text-ink-faint">{t.visit.address}</h3>
          <address class="mt-2 text-lg not-italic" dir="ltr" lang="nl-BE">
            {settings.street}<br />{settings.postcode} {settings.city}
          </address>
          <h3 class="mt-5 text-sm font-semibold text-ink-faint">{t.visit.phone}</h3>
          <a href={telHref} class="mt-2 inline-block text-lg tabular-nums underline decoration-rosewood underline-offset-4 hover:decoration-accent" dir="ltr">
            {settings.phone}
          </a>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href={routeHref} class="btn btn-primary" target="_blank" rel="noopener">
              <Icon name="ph:navigation-arrow" class="size-5" aria-hidden="true" />
              {t.cta.route}
            </a>
            <a href={telHref} class="btn btn-quiet">
              <Icon name="ph:phone" class="size-5" aria-hidden="true" />
              {t.cta.call}
            </a>
          </div>
        </div>

        <div>
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 class="text-sm font-semibold text-ink-faint">{t.visit.hours}</h3>
            <OpenBadge locale={locale} />
          </div>
          <dl class="mt-3 divide-y divide-petal" data-hours-table>
            {
              DAYS.map((day) => {
                const h = byDay.get(day);
                const open = h && !h.closed && h.open && h.close;
                return (
                  <div
                    class="-mx-3 flex items-center justify-between gap-4 rounded-xl px-3 py-2.5 data-today:bg-accent-soft data-today:font-medium"
                    data-day={day}
                  >
                    <dt class="flex items-center gap-2 capitalize">
                      {t.days[day]}
                      <span class="hidden rounded-full bg-accent px-2 py-0.5 text-xs text-cream normal-case" data-today-tag>
                        {t.visit.today}
                      </span>
                    </dt>
                    <dd class:list={['tabular-nums', !open && 'text-ink-faint']} dir="ltr">
                      {open ? `${h.open} – ${h.close}` : <span dir="auto">{t.visit.closed}</span>}
                    </dd>
                  </div>
                );
              })
            }
          </dl>
        </div>
      </div>
    </div>

    <!-- Click-to-load map: nothing is requested from Google until the visitor asks for it (GDPR). -->
    <div class="md:col-span-7" data-reveal style="--i:1">
      <div class="relative h-full min-h-[22rem] overflow-hidden rounded-(--radius-card) bg-blush" data-map>
        <svg class="absolute inset-0 size-full text-rosewood/70" aria-hidden="true" preserveAspectRatio="xMidYMid slice" viewBox="0 0 600 450">
          <g fill="none" stroke="currentColor" stroke-linecap="round">
            <path d="M-20 300 C120 260 220 330 330 250 S520 140 640 170" stroke-width="22" stroke="#fdf8f5" />
            <path d="M-20 300 C120 260 220 330 330 250 S520 140 640 170" stroke-width="1.5" />
            <path d="M180 -20 C200 120 160 260 240 470" stroke-width="14" stroke="#fdf8f5" />
            <path d="M180 -20 C200 120 160 260 240 470" stroke-width="1.5" />
            <path d="M420 -20 L380 470" stroke-width="10" stroke="#fdf8f5" />
            <path d="M-20 120 L640 60" stroke-width="8" stroke="#fdf8f5" />
            <path d="M-20 400 L640 380" stroke-width="8" stroke="#fdf8f5" />
          </g>
        </svg>
        <div class="relative flex h-full min-h-[22rem] flex-col items-center justify-center gap-4 p-6 text-center">
          <span class="flex size-14 items-center justify-center rounded-full bg-accent text-cream shadow-[0_12px_30px_-12px_rgb(169_77_100/0.8)]">
            <Icon name="ph:map-pin-fill" class="size-7" aria-hidden="true" />
          </span>
          <p class="text-lg font-medium" dir="ltr" lang="nl-BE">{settings.street}, {settings.city}</p>
          <button type="button" class="btn btn-quiet bg-cream/90" data-map-load data-src={mapEmbedSrc} data-title={t.visit.mapTitle}>
            <Icon name="ph:map-trifold" class="size-5" aria-hidden="true" />
            {t.visit.mapLoad}
          </button>
          <p class="max-w-[40ch] text-sm text-ink-soft">{t.visit.mapNotice}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { DAYS, zonedNow } from '../lib/hours';

  // Highlight today (in Brussels time) in the opening-hours table.
  const today = DAYS[zonedNow(new Date(), 'Europe/Brussels').dayIndex];
  document.querySelectorAll<HTMLElement>(`[data-hours-table] [data-day="${today}"]`).forEach((row) => {
    row.dataset.today = '';
    row.querySelector('[data-today-tag]')?.classList.remove('hidden');
  });

  document.querySelectorAll<HTMLButtonElement>('[data-map-load]').forEach((btn) =>
    btn.addEventListener('click', () => {
      const wrap = btn.closest<HTMLElement>('[data-map]')!;
      const iframe = document.createElement('iframe');
      iframe.src = btn.dataset.src!;
      iframe.title = btn.dataset.title!;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'absolute inset-0 size-full border-0';
      wrap.replaceChildren(iframe);
    }),
  );
</script>
