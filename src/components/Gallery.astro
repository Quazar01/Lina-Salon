---
import { Image, getImage } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import gallery from '../content/gallery.json';
import { t as tr, ui, type Locale, type Localized } from '../lib/i18n';
import { resolveImage } from '../lib/images';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);

const items = await Promise.all(
  (gallery.images as { image: string; alt: Localized }[]).map(async (g) => {
    const src = resolveImage(g.image);
    if (!src) return null;
    const full = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp' });
    return { src, alt: tr(g.alt, locale), full: full.src };
  }),
).then((list) => list.filter((x): x is NonNullable<typeof x> => x !== null));
---

{
  items.length > 0 && (
    <section id="gallery" class="py-20 md:py-28" aria-labelledby="gallery-title">
      <div class="container-page">
        <header data-reveal>
          <p class="eyebrow">{t.gallery.eyebrow}</p>
          <h2 id="gallery-title" class="display mt-3 text-[2.1rem] md:text-5xl">
            {t.gallery.title}
          </h2>
        </header>

        <!-- Phones: a swipeable strip that peeks the next photo. Desktop: a masonry grid. -->
        <ul
          class="no-scrollbar -mx-4 mt-8 flex snap-x snap-mandatory scroll-px-4 gap-3 overflow-x-auto overscroll-x-contain px-4 sm:-mx-6 sm:scroll-px-6 sm:px-6 md:mx-0 md:block md:columns-3 md:gap-4 md:overflow-visible md:px-0"
          data-gallery
        >
          {items.map((item, i) => (
            <li class="w-[78%] shrink-0 snap-start sm:w-[45%] md:mb-4 md:w-auto md:break-inside-avoid" data-reveal style={`--i:${i % 3}`}>
              <button
                type="button"
                class="group block w-full overflow-hidden rounded-2xl bg-petal transition-transform duration-150 ease-out active:scale-[0.98]"
                data-lightbox-index={i}
                data-full={item.full}
                data-alt={item.alt}
                aria-label={`${t.gallery.open}: ${item.alt}`}
              >
                <Image
                  src={item.src}
                  alt={item.alt}
                  widths={[360, 540, 720]}
                  sizes="(min-width: 768px) 33vw, 78vw"
                  class="aspect-[4/5] w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] md:aspect-auto"
                />
              </button>
            </li>
          ))}
        </ul>
      </div>
      <Lightbox locale={locale} count={items.length} />
    </section>
  )
}
